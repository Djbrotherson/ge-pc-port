{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://n64-portkit.local/profile.schema.json",
  "title": "N64 Portkit game profile",
  "type": "object",
  "required": [
    "schema",
    "name"
  ],
  "additionalProperties": true,
  "properties": {
    "schema": {
      "type": "integer",
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "source_roots": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "exclude_roots": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "layout_contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "size"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1
          },
          "size": {
            "type": "integer",
            "minimum": 1
          },
          "why": {
            "type": "string"
          },
          "scope": {
            "type": "string",
            "enum": [
              "host",
              "serialized",
              "graphics_stride"
            ],
            "default": "serialized"
          }
        }
      }
    },
    "offset_contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "member",
          "offset"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1
          },
          "member": {
            "type": "string",
            "minLength": 1
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "why": {
            "type": "string"
          }
        }
      }
    },
    "fit_contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "payload_type",
          "container_type"
        ],
        "additionalProperties": false,
        "properties": {
          "payload_type": {
            "type": "string",
            "minLength": 1
          },
          "container_type": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "type": "string"
          }
        }
      }
    }
  }
}
